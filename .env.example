# ==============================================================================
# CODINGO - VARIABLES D'ENVIRONNEMENT (.env.example)
# Copiez ce fichier vers .env.local pour configurer votre environnement local.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FIREBASE CLIENT (Accès public depuis le navigateur pour Auth, Firestore, etc.)
# ------------------------------------------------------------------------------
# Clé API publique du projet Firebase web
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyExampleKey1234567890

# Domaine d'authentification Firebase (ex: codingo-app.firebaseapp.com)
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=codingo-app.firebaseapp.com

# Identifiant unique du projet Firebase (ex: codingo-app)
NEXT_PUBLIC_FIREBASE_PROJECT_ID=codingo-app

# Bucket de stockage Cloud Storage pour les photos de profil (ex: codingo-app.appspot.com)
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=codingo-app.appspot.com

# Identifiant de l'expéditeur Firebase Cloud Messaging (numéro de projet)
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012

# Identifiant d'application Firebase Web
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Clé publique VAPID pour les notifications push Web Push (Cloud Messaging)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=BExampleVapidKeyGeneratedInFirebaseConsoleForWebPush1234567890

# ------------------------------------------------------------------------------
# 2. FIREBASE ADMIN SDK (Côté serveur uniquement - NE JAMAIS EXPOSER AU CLIENT)
# ------------------------------------------------------------------------------
# Email du compte de service Firebase Admin (généré dans la console Google Cloud / Firebase)
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@codingo-app.iam.gserviceaccount.com

# Clé privée du compte de service Firebase Admin (conserver les sauts de ligne \n)
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC7...Exemple...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 3. INTELLIGENCE ARTIFICIELLE (Google Gemini LLM pour la correction des exercices)
# ------------------------------------------------------------------------------
# Clé d'API Google Gemini utilisée côté serveur uniquement pour le tutorat et la correction pédagogique
GEMINI_API_KEY=AIzaSyExampleGeminiApiKey123456789

# ------------------------------------------------------------------------------
# 4. PAIEMENT & ABONNEMENTS (SaaSpay Sandbox / Production)
# ------------------------------------------------------------------------------
# Clé API secrète de la passerelle de paiement SaaSpay pour générer les sessions de paiement
SAASPAY_API_KEY=saaspay_sec_test_example_key_12345

# Secret de signature des webhooks SaaSpay pour authentifier les événements de paiement côté serveur
SAASPAY_WEBHOOK_SECRET=saaspay_whsec_example_secret_67890

# URL publique de l'application pour les redirections de paiement (ex: http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 5. ADMINISTRATION & SÉCURITÉ
# ------------------------------------------------------------------------------
# Mot de passe initial du compte administrateur "boulka-admin" lors de l'initialisation (seed)
ADMIN_INITIAL_PASSWORD=ChangeMeAdminInitial2026!
